{
  "name": "redis-clubhouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "redis-clubhouse": "bin/redis-clubhouse.mjs"
  },
  "scripts": {
    "dev": "tsx src/terminal/cli.tsx",
    "build": "npm run check && npm run build:cli",
    "build:cli": "esbuild src/terminal/cli.tsx --bundle --platform=node --format=esm --packages=external --outfile=build/cli.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "python3 tests/terminal-e2e.py"
  },
  "dependencies": {
    "@redis/client": "^5.12.1",
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
